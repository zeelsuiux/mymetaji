Options -Indexes

# Tenant storage. shops/<tenant>/database holds the JSON stores, and
# team.json in there holds bcrypt password hashes. These are read by PHP from
# disk, never served - a tenant is reached through the rewrite rules below
# instead, so denying the data files costs the application nothing.
#
# Each tenant database folder also carries its own deny rule; this is the
# backstop for a folder provisioned before that existed, or one created while
# .htaccess overrides were off.
<FilesMatch "\.(json|jsonl|db|sqlite|sqlite3|log|ini|bak|sql)$">
    Require all denied
</FilesMatch>

# ...but the two that are genuinely public when requested through a tenant URL.
<Files "manifest.json">
    Require all granted
</Files>

RewriteEngine On

# Shared panel URLs: /cst_1/anything maps to the one root-level PHP file.
RewriteRule ^(cst_[0-9]+)/?$ index.php?tenant=$1 [QSA,L]
RewriteRule ^(cst_[0-9]+)/assets/(.*)$ shops/$1/assets/$2 [QSA,L]
RewriteRule ^(cst_[0-9]+)/downloads/(.*)$ downloads/$2 [L]
RewriteRule ^(cst_[0-9]+)/(manifest\.json)$ manifest.php?tenant=$1 [QSA,L]
RewriteRule ^(cst_[0-9]+)/(service-worker\.js)$ service-worker.php?tenant=$1 [QSA,L]
RewriteRule ^(cst_[0-9]+)/(.*)$ $2?tenant=$1 [QSA,L]
